name: Keepalive
on:
  schedule:
    - cron: "0 22 * * *"
    - cron: "0 7 * * *"
  workflow_dispatch:
permissions:
  contents: read
jobs:
  ping:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Random delay
        run: |
          sleep $((RANDOM % 151))
          echo "Ping at $(date -u)"
